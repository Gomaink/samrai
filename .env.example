# Physical volume name used by Docker Compose.
# New installations use samrai-data. When reusing an older .env file,
# Compose automatically falls back to the legacy pageturner-data volume.
SAMRAI_DOCKER_VOLUME=samrai-data

SAMRAI_ADDRESS=:8080
SAMRAI_DATA_DIR=./data
SAMRAI_LOG_LEVEL=info
SAMRAI_SHUTDOWN_TIMEOUT=10s
SAMRAI_MAX_DB_CONNECTIONS=4
SAMRAI_SESSION_DURATION=720h
SAMRAI_COOKIE_SECURE=false
SAMRAI_ARGON2_MEMORY_MIB=64
SAMRAI_ARGON2_ITERATIONS=3
SAMRAI_ARGON2_PARALLELISM=2
SAMRAI_MAX_UPLOAD_MIB=2048
SAMRAI_MAX_ARCHIVE_MIB=8192
SAMRAI_MAX_PAGE_MIB=128
SAMRAI_MAX_ARCHIVE_ENTRIES=10000
SAMRAI_MAX_PAGES=5000

# Optimized image cache
SAMRAI_IMAGE_WORKERS=2
SAMRAI_IMAGE_CACHE_MIB=5120
SAMRAI_IMAGE_QUALITY=82
SAMRAI_IMAGE_MAX_WIDTH=3840
SAMRAI_CACHE_CLEANUP_INTERVAL=1h

# Optional OCR for scanned PDFs or PDFs with an invalid text layer
# On Windows, the common path is C:\Program Files\Tesseract-OCR\tesseract.exe
SAMRAI_TESSERACT_PATH=
SAMRAI_OCR_WORKERS=1
SAMRAI_OCR_TIMEOUT=90s


# CBR/RAR and CB7/7z files. samrai automatically detects 7-Zip
# (including C:\Program Files\7-Zip\7z.exe on Windows) and unar/lsar.
# Set these only when the executables are installed elsewhere.
SAMRAI_7ZIP_PATH=
SAMRAI_LSAR_PATH=
SAMRAI_UNAR_PATH=
